&tlmm {
	cirrus_reset_default_0: cirrus_reset_default_0 {
		mux {
			function = "gpio";
			pins = "gpio85";
		};

		config {
			output-high;
			bias-disable;
			drive-strength = <0x10>;
			pins = "gpio85";
		};
	};

	cirrus_reset_default_1: cirrus_reset_default_1 {
		mux {
			function = "gpio";
			pins = "gpio111";
		};

		config {
			output-high;
			bias-disable;
			drive-strength = <0x10>;
			pins = "gpio111";
		};
	};

	cirrus_irq_default {
		cirrus_irq_default_0: cirrus_irq_default_0 {
			mux {
				function = "gpio";
				pins = "gpio98";
			};

			config {
				bias-pull-up;
				input-enable;
				drive-strength = <0x2>;
				pins = "gpio98";
			};
		};

		cirrus_irq_default_1: cirrus_irq_default_1 {
			mux {
				function = "gpio";
				pins = "gpio99";
			};

			config {
				bias-pull-up;
				input-enable;
				drive-strength = <0x2>;
				pins = "gpio99";
			};
		};
	};

	wcd_usbss_reset_active: wcd_usbss_reset_active {
		mux {
			function = "gpio";
			pins = "gpio152";
		};
		config {
			output-high;
			drive-strength = <16>;
			pins = "gpio152";
		};
	};

	wcd_usbss_reset_sleep: wcd_usbss_reset_sleep {
		mux {
			function = "gpio";
			pins = "gpio152";
		};
		config {
			output-low;
			bias-disable;
			drive-strength = <16>;
			pins = "gpio152";
		};
	};

	sbu_uart_en_ctrl {
		sbu_uart_en_active: uart_audio_en_active {
			config {
				bias-disable;
				drive-strength = <2>; /* 2 MA */
				output-high;
				pins = "gpio53";
			};

			mux {
				function = "gpio";
				pins = "gpio53";
			};
		};

		sbu_uart_en_idle: uart_audio_en_idle {
			config {
				bias-pull-down;
				drive-strength = <2>; /* 2 MA */
				output-low;
				pins = "gpio53";
			};

			mux {
				function = "gpio";
				pins = "gpio53";
			};
		};
	};

};